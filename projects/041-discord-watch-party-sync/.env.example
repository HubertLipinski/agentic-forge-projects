# .env.example
# This is an example environment file. Copy this file to a new file named .env
# and fill in the values for your Discord bot. Do NOT commit the .env file to git.

# --- Discord Bot Credentials ---
# Your bot's secret token. Get this from the Discord Developer Portal under your application's "Bot" page.
# Example: MjA2NDc4OAk4NTk4MzA.G3dCba.qL4lS3cretT0kenF0rMyBot
DISCORD_TOKEN=

# The application's client ID. Find this on the "General Information" page of your application in the Discord Developer Portal.
# Example: 123456789012345678
CLIENT_ID=

# The ID of your development/testing server (guild). This is used for instantly registering slash commands during development.
# To get this, right-click your server icon in Discord (with Developer Mode enabled) and select "Copy Server ID".
# Example: 987654321098765432
GUILD_ID=

# --- Bot Configuration (Optional) ---
# The minimum logging level. Defaults to 'info' if not set.
# Recommended values: 'debug', 'info', 'warn', 'error', 'fatal'.
# For development, 'debug' is useful. For production, 'info' is standard.
# LOG_LEVEL=info