<%#
// templates/router.js.ejs
//
// EJS template for generating the Express Router file. This file contains all
// the endpoint definitions, validation middleware, and controller logic that
// connects the Express framework to the user's service functions.
//
// This template receives the following data:
// - `services`: An array of objects, each representing a service file to import from.
//   - `path`: The relative path to the service file (e.g., '../examples/services/user-service.js').
//   - `functions`: An array of function names to import from that service file.
// - `endpoints`: An array of endpoint objects, each detailing a single API route.
//   - `method`: The HTTP method (e.g., 'get', 'post').
//   - `path`: The Express-style route path (e.g., '/users/:id').
//   - `handlerName`: The name of the service function that handles this endpoint.
//   - `description`: The description of the endpoint from JSDoc.
//   - `parameters`: An object containing categorized parameters.
//     - `path`: Array of path parameters with `name` and `schema`.
//     - `query`: Array of query parameters with `name`, `schema`, and `required`.
//     - `body`: A single body object with `schema`.
//
// The generated code is production-quality, using modern ES modules, async/await,
// and robust error handling. It leverages AJV for efficient request validation.
-%>
/**
 * @file This file was auto-generated by jsdoc-to-rest.
 * DO NOT MODIFY IT BY HAND.
 *
 * This file contains the Express router that defines all the API endpoints,
 * configures request validation middleware, and connects routes to the
 * appropriate service functions.
 */

import { Router } from 'express';
import Ajv from 'ajv';
<% if (services.length > 0) { -%>

// --- Service Imports ---
// Import the handler functions from the user-defined service files.
<% services.forEach(service => { -%>
import { <%- service.functions.join(', ') %> } from '<%- service.path %>';
<% }); -%>
<% } -%>

// --- Router and Validator Setup ---
const router = Router();
const ajv = new Ajv({ coerceTypes: true, allErrors: true });

// --- Middleware ---

/**
 * A generic error handler middleware to catch exceptions from async route handlers.
 * It ensures that any error thrown in a service function is properly processed
 * and sent as a JSON response.
 *
 * @param {Function} fn - The async route handler function.
 * @returns {Function} An Express middleware function that wraps the async handler.
 */
const asyncHandler = (fn) => (req, res, next) =>
  Promise.resolve(fn(req, res, next)).catch(next);

/**
 * Creates a validation middleware for a given JSON schema.
 * This is used to validate request body, query parameters, and path parameters.
 *
 * @param {'body' | 'query' | 'params'} source - The source of the data to validate in the request object.
 * @param {object} schema - The JSON schema to validate against.
 * @returns {Function} An Express middleware function that performs validation.
 */
const validate = (source, schema) => {
  if (!schema) {
    // If no schema is defined, no validation is needed.
    return (req, res, next) => next();
  }

  const validateFn = ajv.compile(schema);

  return (req, res, next) => {
    const dataToValidate = req[source];
    if (validateFn(dataToValidate)) {
      return next();
    }

    // If validation fails, send a 400 Bad Request response with details.
    res.status(400).json({
      error: 'Validation failed',
      source,
      details: validateFn.errors.map((e) => ({
        path: e.instancePath || 'N/A',
        message: e.message,
        params: e.params,
      })),
    });
  };
};

// --- Endpoint Definitions ---
<% endpoints.forEach(endpoint => { -%>

/**
 * @route <%- endpoint.method.toUpperCase() %> <%- endpoint.path %>
 * @description <%- endpoint.description %>
 */
router.<%- endpoint.method %>(
  '<%- endpoint.path %>',
  <%
  const validationMiddleware = [];
  if (endpoint.parameters.body?.schema) {
    validationMiddleware.push(`validate('body', ${JSON.stringify(endpoint.parameters.body.schema, null, 2)})`);
  }
  if (endpoint.parameters.query.length > 0) {
    const querySchema = {
      type: 'object',
      properties: endpoint.parameters.query.reduce((acc, param) => {
        acc[param.name] = param.schema;
        return acc;
      }, {}),
      required: endpoint.parameters.query.filter(p => p.required).map(p => p.name),
    };
    validationMiddleware.push(`validate('query', ${JSON.stringify(querySchema, null, 2)})`);
  }
  if (endpoint.parameters.path.length > 0) {
    const pathSchema = {
      type: 'object',
      properties: endpoint.parameters.path.reduce((acc, param) => {
        acc[param.name] = param.schema;
        return acc;
      }, {}),
      required: endpoint.parameters.path.map(p => p.name),
    };
    validationMiddleware.push(`validate('params', ${JSON.stringify(pathSchema, null, 2)})`);
  }
  if (validationMiddleware.length > 0) {
    %><%- validationMiddleware.join(',\n  ') %>,
  <% } -%>
  asyncHandler(async (req, res) => {
    // Combine all parameters into a single object for the handler.
    // Note: Path and query params are strings by default; AJV's `coerceTypes` handles conversion.
    const handlerArgs = {
      ...req.params,
      ...req.query,
      <% if (endpoint.parameters.body) { -%>
      body: req.body,
      <% } -%>
    };

    // Call the service function with the prepared arguments.
    // The service function is expected to handle the business logic.
    const result = await <%- endpoint.handlerName %>(handlerArgs);

    // Default to a 200 OK status if the service function returns data
    // without throwing an error. A more specific status can be configured
    // via @returns JSDoc tags.
    // NOTE: This template uses a simplified response logic. The service function's
    // return value is sent directly as the response body. For more complex
    // scenarios (e.g., setting headers, different status codes), the service
    // function would need to interact with the `res` object directly, or this
    // template could be customized to interpret the result differently.
    res.status(200).json(result);
  }),
);
<% }); -%>

export default router;