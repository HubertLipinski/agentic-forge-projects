/**
 * @file server.js
 * @description Generated Express.js server entry point.
 *
 * This server is automatically generated by the JSDoc-to-REST-API tool.
 * It sets up a basic Express application, includes essential middleware for
 * security and parsing, mounts the API routes, and defines error handling.
 *
 * To start the server, run: `node server.js`
 */

import express from 'express';
import helmet from 'helmet';
import cors from 'cors';
import { apiRouter } from './router.js';

// --- Server Configuration ---

// Use the PORT environment variable if available, otherwise default to 3000.
const PORT = process.env.PORT ?? 3000;
const HOST = process.env.HOST ?? '0.0.0.0';

// --- Application Setup ---

const app = express();

// --- Core Middleware ---

// 1. Helmet: Applies a suite of security-related HTTP headers to enhance security.
//    - Sets headers like Content-Security-Policy, Strict-Transport-Security, etc.
app.use(helmet());

// 2. CORS (Cross-Origin Resource Sharing): Enables controlled access from different origins.
//    - The default configuration (`cors()`) is permissive, allowing all origins.
//    - For production, configure it with a specific origin: `app.use(cors({ origin: 'https://your-frontend.com' }))`
app.use(cors());

// 3. Express JSON Parser: Parses incoming requests with JSON payloads.
//    - Populates `req.body` with the parsed JSON object.
//    - A limit is set to prevent payload-based denial-of-service attacks.
app.use(express.json({ limit: '1mb' }));

// 4. Express URL-Encoded Parser: Parses incoming requests with URL-encoded payloads.
//    - Often used for form submissions. `extended: true` allows for rich objects.
app.use(express.urlencoded({ extended: true }));

// --- Application Routes ---

// Health check endpoint to verify that the server is running.
app.get('/health', (req, res) => {
  res.status(200).json({
    status: 'ok',
    uptime: process.uptime(),
    timestamp: new Date().toISOString(),
  });
});

// Mount the generated API routes under the `/api` prefix.
// All routes defined in `router.js` will be accessible from `/api/...`.
app.use('/api', apiRouter);

// --- Error Handling Middleware ---

// 1. 404 Not Found Handler: Catches requests for routes that do not exist.
//    This middleware is placed after all other routes.
app.use((req, res, next) => {
  res.status(404).json({
    error: {
      type: 'NotFound',
      message: `The requested resource '${req.originalUrl}' was not found on this server.`,
    },
  });
});

// 2. Global Error Handler: A catch-all for errors that occur during request processing.
//    Express automatically calls this middleware if `next(error)` is invoked anywhere.
//    It should have four arguments: (err, req, res, next).
app.use((err, req, res, next) => {
  // Avoid sending detailed stack traces in a production environment.
  const isProduction = process.env.NODE_ENV === 'production';
  const statusCode = typeof err.status === 'number' ? err.status : 500;

  // Log the full error for debugging purposes, regardless of environment.
  console.error(
    `[${new Date().toISOString()}] Error on ${req.method} ${req.originalUrl}:`,
    err,
  );

  res.status(statusCode).json({
    error: {
      type: err.name ?? 'InternalServerError',
      message: err.message ?? 'An unexpected internal server error occurred.',
      // Optionally include the stack trace in development for easier debugging.
      ...(isProduction ? {} : { stack: err.stack }),
    },
  });
});

// --- Server Startup ---

/**
 * Starts the Express server and listens for incoming connections.
 */
async function startServer() {
  try {
    app.listen(PORT, HOST, () => {
      console.log(`✅ Server is running and listening on http://${HOST}:${PORT}`);
      console.log(`🚀 API routes are available at http://${HOST}:${PORT}/api`);
      console.log(
        `🩺 Health check endpoint is at http://${HOST}:${PORT}/health`,
      );
      console.log('Press CTRL+C to stop the server.');
    });
  } catch (error) {
    console.error('❌ Failed to start the server:', error);
    process.exit(1); // Exit with a non-zero code to indicate failure.
  }
}

// Graceful shutdown handling
const shutdown = (signal) => {
  console.log(`\n[${signal}] signal received. Shutting down gracefully...`);
  // In a real application, you would close database connections, etc. here.
  process.exit(0);
};

process.on('SIGINT', () => shutdown('SIGINT'));
process.on('SIGTERM', () => shutdown('SIGTERM'));

// Execute the server startup function.
startServer();