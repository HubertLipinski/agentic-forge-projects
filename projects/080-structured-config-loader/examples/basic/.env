# .env file for structured-config-loader basic example
#
# These variables will be loaded by the `dotenv` package and can be used to
# override values from config files.
#
# The `env` parser in the library supports a prefix and a separator for
# creating nested objects. The default separator is '__'.
#
# Here, we use the prefix 'APP' and separator '__' to match the example setup.
# Example: APP_DATABASE__USER becomes { database: { user: '...' } }

# Override the database user from the YAML file
APP_DATABASE__USER=env_user

# Provide the database password, which is required by the schema but not in the YAML
APP_DATABASE__PASSWORD=env_secret_password

# Override a nested value from the YAML file
# This will be coerced to the boolean `false`
APP_FEATURES__ALPHA=false

# Override the log level. This will be merged with the command-line argument.
# Since command-line arguments have higher priority, the value from the CLI
# (`--log.level=debug`) will ultimately be used.
APP_LOG__LEVEL=warn