{
  "name": "auto-semver-tagger",
  "version": "1.0.0",
  "description": "A CLI utility that automates Semantic Versioning for Git repositories by analyzing Conventional Commits.",
  "main": "src/main.js",
  "type": "module",
  "bin": {
    "auto-semver-tag": "bin/auto-semver-tag.js"
  },
  "scripts": {
    "start": "node bin/auto-semver-tag.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/auto-semver-tagger.git"
  },
  "keywords": [
