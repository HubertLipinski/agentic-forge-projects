    "automation",
    "versioning",
    "tagging",
    "changelog",
    "cli"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "conventional-commits-parser": "^5.0.0",
    "execa": "^8.0.1",
    "semver": "^7.6.2",
    "yargs": "^17.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/"
  ]
