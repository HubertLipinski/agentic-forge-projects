  "type": "module",
  "bin": {
    "run-tasks": "bin/run-tasks.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "example:monorepo": "node examples/monorepo-build/run.js"
  },
  "keywords": [
    "task-runner",
    "dag",
    "concurrency",
    "parallel",
    "build",
    "workflow",
    "monorepo",
    "orchestration",
    "pipeline"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/concurrent-task-runner.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/concurrent-task-runner/issues"
  },
  "homepage": "https://github.com/your-username/concurrent-task-runner#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "p-limit": "^5.0.0"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ]
